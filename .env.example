DB_HOST=localhost
DB_PORT=5432
DB_NAME=otolaryn

# Used only by the TypeORM migration CLI. Owns the schema; still subject to
# RLS because business tables use FORCE ROW LEVEL SECURITY.
DB_OWNER_USER=otolaryn_owner
DB_OWNER_PASSWORD=owner_change_me

# Used by the running NestJS process. No BYPASSRLS, no DDL rights.
DB_APP_USER=otolaryn_app
DB_APP_PASSWORD=app_change_me

JWT_SECRET=dev_only_change_me_in_every_other_environment
JWT_EXPIRES_IN=1h
# Tope absoluto de una sesión aunque se vaya renovando con actividad (horas).
SESSION_MAX_HOURS=12

# Archivos adjuntos de las consultas: carpeta donde se guardan (fuera del
# directorio web, solo accesible por el usuario de la aplicación) y, opcional,
# socket de ClamAV para analizarlos con antivirus antes de guardarlos. Sin socket
# no se analiza; con él puesto, un archivo que no se pueda analizar se rechaza.
ATTACHMENTS_DIR=./storage/attachments
# ATTACHMENTS_CLAMAV_SOCKET=/run/clamav/clamd.ctl
