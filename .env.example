DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=otolaryn

# Used only by the TypeORM migration CLI. Owns the schema; still subject to
# RLS because business tables use FORCE ROW LEVEL SECURITY.
DB_OWNER_USER=otolaryn_owner
DB_OWNER_PASSWORD=owner_change_me

# Used by the running NestJS process. No BYPASSRLS, no DDL rights.
DB_APP_USER=otolaryn_app
DB_APP_PASSWORD=app_change_me

JWT_SECRET=dev_only_change_me_in_every_other_environment
JWT_EXPIRES_IN=1h
# Recordatorios de citas por WhatsApp. Configurar en el backend de la clínica
# que usa la integración. La plantilla aprobada debe tener un único parámetro
# de texto en el cuerpo, para la fecha y hora de la cita.
# WHATSAPP_REMINDER_PHONE_NUMBER_ID=
# WHATSAPP_REMINDER_GRAPH_VERSION=
# WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_REMINDER_LANGUAGE=es_ES
# WHATSAPP_REMINDER_ACCESS_TOKEN=
# Solo en DEMO, debe ser un número distinto del teléfono ficticio y estar en
# WHATSAPP_BOOKING_ALLOWED_PHONES.
# WHATSAPP_REMINDER_DEMO_RECIPIENT=
# Tope absoluto de una sesión aunque se vaya renovando con actividad (horas).
SESSION_MAX_HOURS=12

# Archivos adjuntos de las consultas: carpeta donde se guardan (fuera del
# directorio web, solo accesible por el usuario de la aplicación) y, opcional,
# socket de ClamAV para analizarlos con antivirus antes de guardarlos. Sin socket
# no se analiza; con él puesto, un archivo que no se pueda analizar se rechaza.
ATTACHMENTS_DIR=./storage/attachments
# ATTACHMENTS_CLAMAV_SOCKET=/run/clamav/clamd.ctl

# Certificado digital (.p12) con el que el servidor firma las órdenes de
# domiciliación SEPA antes de enviarlas al cliente. Lo normal es subirlo desde el
# panel (Facturación → Certificado digital): el archivo y su contraseña se guardan
# CIFRADOS en la base de datos con una clave derivada de JWT_SECRET, así que un
# volcado de la base de datos por sí solo no sirve para firmar. Ojo: si algún día
# se cambia JWT_SECRET, hay que volver a subir el certificado.
#
# Alternativa, sin pasar por el panel: dejar el archivo en el servidor, fuera del
# directorio web y con permisos de solo lectura para el usuario de la aplicación,
# e indicarlo aquí. Si hay uno subido desde el panel, ese tiene prioridad.
#
# Sin ninguno las órdenes salen sin firma (desarrollo); con uno puesto, si no se
# puede usar (contraseña mala, caducado...) NO se genera la orden en vez de
# enviarla sin firmar. Al renovar el archivo de esta alternativa basta con
# sustituirlo; si cambia la contraseña, hay que reiniciar el backend.
# CREDITOR_P12_PATH=/var/www/vhosts/.../mederi-secrets/acreedor.p12
# CREDITOR_P12_PASSPHRASE=…
